# Production only: set a reachable PostgreSQL URL with your provider's TLS settings.
# DATABASE_URL=postgresql://user:password@host:5432/orbitfeed?sslmode=require
DB_POOL_MAX=10

# Development only when DATABASE_URL is not configured (SQLite WAL).
SQLITE_FILE=./data/orbitfeed.sqlite

# App-owned secret: generate with `openssl rand -hex 32` (do not use JWT_SECRET).
# `pnpm dev` generates a process-only key if this is blank.
ORBITFEED_SESSION_SECRET=
# Local HTTP only. Do not use for public HTTPS.
COOKIE_SECURE=false
PORT=3000
HOST=0.0.0.0

# Isolated seed/load testing only.
SEED_ALLOW=yes
SEED_PASSWORD=local-only-load-test-password
